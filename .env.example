# ── Panache Demo Tracker — Environment Variables ──────────────────────────────

# Your Google Sheet ID
# Get it from the sheet URL:
# https://docs.google.com/spreadsheets/d/  <-- THIS PART -->  /edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Option A: Paste the full service account JSON as a single line (for Render)
# In Render dashboard → Environment → Add Environment Variable
# Key: GOOGLE_SERVICE_ACCOUNT_JSON
# Value: paste the entire contents of your service-account.json file
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"demo-tracker@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"..."}

# Option B: For local development only — path to the downloaded JSON key file
# GOOGLE_KEY_FILE=./service-account.json

# Server port (Render sets this automatically)
PORT=3000
